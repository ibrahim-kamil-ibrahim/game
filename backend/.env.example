# ---------------------------------------------------------------------------
# Game Rental Management System - Backend environment
# Copy to .env and replace every secret before deploying to production.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# DATABASE_URL is what the API uses at runtime (Supabase pooler is recommended).
# DIRECT_URL is used only by Prisma migrations (Supabase direct/session mode).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_rental?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/game_rental?schema=public"

# JSON Web Tokens (use long random values, e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-characters-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-characters-long"
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
# A refresh response lost in transit must not log the user out. A revoked token
# can still be exchanged within this grace window; after it, reuse revokes the
# entire token family.
REFRESH_REUSE_GRACE_SECONDS=60

# Secret used to hash machine QR tokens (HMAC-SHA256)
QR_HMAC_SECRET="change-me-qr-secret-min-32-characters-long"

# Comma separated list of allowed browser origins.
# Example (Render + Vercel):
# CORS_ORIGINS="https://your-admin.vercel.app"
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"
# Singular alias is also accepted and merged with CORS_ORIGINS.
# CORS_ORIGIN="https://your-admin.vercel.app"

# Refresh cookie policy. Use "none" only with HTTPS and a cross-origin admin
# (for example Vercel -> Render). Use "lax" for same-origin deployments.
# Default: none in production, lax in development.
# COOKIE_SAME_SITE=none

# Business defaults
BUSINESS_NAME="GameZone Gaming Center"
BUSINESS_TIMEZONE="Africa/Addis_Ababa"
BUSINESS_CURRENCY="ETB"

# Bootstrap admin account created by `npm run seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FULL_NAME="System Administrator"
SEED_ADMIN_PHONE="+251900000000"
SEED_SAMPLE_DATA=true

# Worker / scheduler tuning
SESSION_EXPIRY_INTERVAL_MS=5000
